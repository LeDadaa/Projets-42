# Copier en `.env` puis renseigner les valeurs. Ce fichier est versionne,
# `.env` ne l'est pas : n'y mettre aucune valeur reelle.
#
#   cp srcs/.env.example srcs/.env
#
# Les identifiants Postgres ne vivent PAS ici mais dans des fichiers de secrets
# Docker, que le compose monte sous /run/secrets et que `config.py` lit via le
# suffixe _FILE. Ils sont ignores par git, donc a creer apres un clone :
#
#   mkdir -p secrets
#   printf 'maia' > secrets/POSTGRES_USER
#   openssl rand -hex 24 > secrets/POSTGRES_PASSWORD
#
# Sans ces deux fichiers, `docker compose` refuse de demarrer.

# --- Base de donnees ---
# POSTGRES_USER et POSTGRES_PASSWORD viennent des fichiers de secrets ci-dessus.
POSTGRES_DB=pgdb
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Echappatoire : URL fournie par un hebergeur. Laisser vide en local, sinon elle
# court-circuite la composition a partir des POSTGRES_*.
DATABASE_URL=

# Journalise chaque requete SQL. Le compose de dev le force a true.
SQL_ECHO=false

# --- Application ---
# Signature des JWT d'acces. Obligatoire, 32 caracteres minimum, l'API refuse
# de demarrer sans. A generer :
#   openssl rand -hex 32
SECRET_KEY=

# Chiffrement des secrets TOTP en base. Doit etre une cle Fernet : 32 octets en
# base64 url-safe (44 caracteres). PAS la meme generation que SECRET_KEY : une
# chaine hexadecimale est refusee par Fernet au premier usage de la 2FA.
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Requise des que la 2FA est active, et exigee par assert_production_ready() en ENVIRONMENT=prod.
TOTP_ENCRYPTION_KEY=

# dev | prod. En prod, la configuration est validee au demarrage : SECRET_KEY
# suffisante, TOTP_ENCRYPTION_KEY renseignee, SERVER_NAME different de localhost.
ENVIRONMENT=dev

# Nom d'hote servi par nginx, et sujet du certificat auto-signe.
#
# Pour jouer a plusieurs machines sur le meme reseau, mettre ici l'adresse de la
# machine qui heberge (`ip -4 addr` ou `ipconfig`), et la reporter dans
# ALLOWED_ORIGINS ci-dessous. Les autres joueurs ouvrent https://<adresse>:8443.
# L'entrypoint nginx regenere le certificat des que SERVER_NAME change, et pose
# une adresse en `IP:` plutot qu'en `DNS:` -- sans quoi aucun navigateur ne la
# reconnait. Le certificat reste auto-signe : l'avertissement est normal.
#
# A savoir : les cookies de session sont `Secure`, donc HTTPS est obligatoire,
# meme sur un reseau local ; et les URL de retour OAuth sont declarees par hote,
# donc la connexion par un fournisseur tiers ne marche que pour l'hote declare.
SERVER_NAME=localhost

# Origine vue par le navigateur, port compris. Sert a construire l'URL de retour
# OAuth. Vide = https://<SERVER_NAME>, c'est-a-dire publie sur le 443.
PUBLIC_URL=https://localhost:8443

# Origines autorisees par CORS, separees par des virgules. En dev comme en prod
# tout passe par nginx sur une origine unique, donc cette liste reste courte.
# Port 8443 : rootless Podman (ecole) ne peut pas bind 80/443 sans droits admin,
# voir docker-compose.yml.
ALLOWED_ORIGINS=https://localhost:8443

# --- Durees de vie, en secondes ---
# 900 = 15 min. Le frontend doit rejouer POST /api/v1/auth/refresh sur 401,
# sinon l'utilisateur est deconnecte en pleine session.
ACCESS_TOKEN_TTL=900

# 1209600 = 14 jours.
REFRESH_TOKEN_TTL=1209600

# 300 = 5 min, fenetre de saisie du code TOTP.
MFA_TOKEN_TTL=300

# --- Amorcage ---
# `true` fait charger le contenu versionne (srcs/backend/seeds/content/*.toml) par
# l'entrypoint via `python -m seeds`, a chaque demarrage de l'API. Idempotent. Un
# fichier de contenu invalide empeche l'API de demarrer.
# A laisser a `true` : sans lui, une base neuve (`make re` efface les volumes)
# n'a ni exercices ni questions de quiz, et aucune partie multijoueur ne demarre.
SEED_DEMO_DATA=true

# --- Correcteur LLM ---
# Le modele tourne sous Ollama sur une machine a GPU, que l'API joint par le
# conteneur tailscale du compose. Sa cle n'est PAS ici : c'est un fichier de
# secret Docker, ignore par git, que `make` detecte pour activer le conteneur :
#
#   printf '%s' 'tskey-...' > secrets/TS_AUTHKEY
#
# Sans ce fichier, ou avec LLM_ENABLED=false, ou si la machine ne repond pas,
# l'eleve lit la correction redigee et dit lui-meme s'il avait juste.
LLM_ENABLED=false

# Adresse Tailscale de la machine (100.x.y.z, colonne "Addresses" de la console
# Tailscale), port d'Ollama. Une IP plutot qu'un nom : rien a resoudre dans le
# proxy, et c'est l'adresse que la politique du tailnet autorise.
LLM_BASE_URL=http://<ip-tailscale-de-la-machine>:11434

# Le modele retenu au banc d'essai (voir srcs/backend/BACKEND.md). Ollama 0.34
# minimum sur la machine.
LLM_MODEL=gemma4:12b

# Proxy HTTP du conteneur tailscale. Vide : connexion directe a LLM_BASE_URL.
LLM_PROXY_URL=http://tailscale:1055

# Secondes d'attente maximale entre deux lectures, generation comprise. La
# connexion, elle, abandonne au bout de 5 s : une machine eteinte bascule vite
# en auto-evaluation.
LLM_TIMEOUT=60

# Tokens (lus + ecrits) que tous les eleves ensemble peuvent consommer par heure
# glissante. Une correction en coute environ 1 200.
LLM_HOURLY_TOKEN_BUDGET=200000

# Reponses corrigees par eleve et par question, sur 24 h glissantes.
LLM_ATTEMPTS_PER_QUESTION=3

# --- Connexion par un fournisseur tiers (OAuth 2.0) ---
# Trois fournisseurs, chacun avec son identifiant et son secret, crees dans la
# console du fournisseur. L'URL de retour a declarer chez lui est
# <PUBLIC_URL>/api/v1/auth/oauth/<google|github|fortytwo>/callback
# (en dev : https://localhost:8443/api/v1/auth/oauth/google/callback, etc.)
# Laisses vides, le fournisseur correspondant est considere comme non configure :
# la route refuse tout de suite et renvoie l'eleve sur /login?error=oauth, plutot
# que de l'envoyer sur la page d'erreur du fournisseur, d'ou il ne reviendrait pas.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
